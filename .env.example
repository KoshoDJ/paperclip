# FightForge Environment Configuration
# Copy this file to .env and fill in your values
# Never commit .env to git

# ─── REQUIRED ─────────────────────────────────────────────────────────────────

# Anthropic API key — all 10 agents run on Claude Sonnet
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# FightForge instance isolation
# Keeps FightForge data separate from any other FightForge installs
FIGHTFORGE_HOME=~/.fightforge
FIGHTFORGE_INSTANCE_ID=fightforge

# ─── SEO / AI VISIBILITY ──────────────────────────────────────────────────────

# DataForSEO — used by SearchScope, CitationScope, and SEO Analyst Agent
# Get from: https://dataforseo.com
DATAFORSEO_USERNAME=your@email.com
DATAFORSEO_PASSWORD=your-api-password

# ─── DATA LAYER ───────────────────────────────────────────────────────────────

# Airtable — all SearchScope and CitationScope output stored here
# Get from: https://airtable.com/create/tokens
AIRTABLE_API_KEY=pat...

# ─── CRM ──────────────────────────────────────────────────────────────────────

# GoHighLevel API — used by COO Agent for webhook triggers and contact updates
# Get from: GHL Settings → API Keys
GHL_API_KEY=

# ─── OPTIONAL ─────────────────────────────────────────────────────────────────

# OpenAI API key — only needed if you want to run non-Claude agents
# FightForge defaults to Claude Sonnet for all agents
# OPENAI_API_KEY=sk-...

# Tailscale auth — enables mobile access from the mat
# Only needed when running: pnpm dev --tailscale-auth
# TAILSCALE_AUTH_KEY=

# ─── NOTES ────────────────────────────────────────────────────────────────────
# SearchScope and CitationScope use DATAFORSEO credentials above
# SearchScope Airtable base ID is configured inside searchscope.json (per client)
# CitationScope Airtable base ID is configured inside citationscope.json (per client)
# See integrations/searchscope/setup.md and integrations/citationscope/setup.md
